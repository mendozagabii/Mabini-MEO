# @mine — copy to .env.local and fill in (Supabase Dashboard → WBLRMS → Settings → API).
# The service-role key is SERVER-ONLY: never expose it to the browser, never commit it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=...

# @mine — step 6: the six workflow notification emails. Leave these blank and the
# system keeps working exactly as it does today; it simply sends no notifications.
# The office sets these in the hosting environment with the mailbox password
# (Gmail needs an app password, not the account password). Never commit the value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# @mine — step 8: the 30-day archive purge (docs/WORKFLOW-DECISIONS.md step 8).
# Left unset, the daily job only writes a report and deletes nothing.
# Set RETENTION_LIVE=1 to let it delete; CRON_SECRET protects the scheduled call
# (Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
RETENTION_LIVE=
CRON_SECRET=
