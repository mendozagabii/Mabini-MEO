# @mine — copy to .env.local and fill in (Supabase Dashboard → WBLRMS → Settings → API).
# The service-role key is SERVER-ONLY: never expose it to the browser, never commit it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=...

# @mine — step 6: the six workflow notification emails. Leave these blank and the
# system keeps working exactly as it does today; it simply sends no notifications.
# The office sets these in the hosting environment with the mailbox password
# (Gmail needs an app password, not the account password). Never commit the value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
